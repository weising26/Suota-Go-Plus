<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>suota_pgp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>Suota Go+</ApplicationTitle>
    <ApplicationId>com.coderjesus.suota_pgp</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>

    <!-- Min Android 7.0; TFM pins targetSdk to 35 (fixes install on Android 12+). -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <!-- Produce an .apk (not .aab) so it can be sideloaded directly. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidSupportedAbis>armeabi-v7a;arm64-v8a</AndroidSupportedAbis>
  </PropertyGroup>

  <!-- Release builds are signed by the CI workflow with an explicit keystore. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidKeyStore Condition="'$(AndroidKeyStore)' == ''">false</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#CC0000" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET 8+ no longer auto-adds the MAUI package; $(MauiVersion) tracks the workload. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Plugin.BLE" Version="3.1.0" />
  </ItemGroup>

</Project>
